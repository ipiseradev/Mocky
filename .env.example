# PostgreSQL - desarrollo local
POSTGRES_USER=mocky
POSTGRES_PASSWORD=mocky_local_dev_only
POSTGRES_DB=mocky

# Backend -> PostgreSQL dentro de Docker
DATABASE_URL=postgresql+psycopg://mocky:mocky_local_dev_only@postgres:5432/mocky

# Backend - CORS y logs
BACKEND_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Frontend - configuracion publica
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8000
NEXT_PUBLIC_INTEGRATION_TIMEOUT_MS=3000

# URL interna reservada para uso futuro del servidor Next.js
BACKEND_INTERNAL_URL=http://backend:8000